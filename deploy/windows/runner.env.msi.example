LOREHUB_WORK_DIR=C:\ProgramData\LoreHub\work
LOREHUB_RUNNER_NAME=windows-runner-01
# Optional fixed UUID. Without it, LoreHub persists one in the work directory.
# LOREHUB_RUNNER_ID=00000000-0000-0000-0000-000000000002
LORE_BIN=C:\Program Files\LoreHub\lore.exe
# The system build prerequisite script installs Rust here. Keep this before the
# existing PATH so SYSTEM jobs can find cargo without a user profile.
CARGO_HOME=C:\ProgramData\LoreHub\toolchains\.cargo
RUSTUP_HOME=C:\ProgramData\LoreHub\toolchains\.rustup
PATH=%CARGO_HOME%\bin;%PATH%
LOREHUB_PUBLIC_URL=https://lorehub.zenogrid.co.kr
# LOREHUB_COORDINATOR_URL=http://coordinator.internal:8080
# Check for a newer signed-in coordinator release every 5 minutes while idle.
LOREHUB_AUTO_UPDATE=true
LOREHUB_UPDATE_INTERVAL_SECONDS=300
# Retry worker/coordinator failures without waiting for Task Scheduler.
LOREHUB_RETRY_INTERVAL_SECONDS=60
LORE_JWT_PRIVATE_KEY=C:\ProgramData\LoreHub\lore-jwt-private.pem
LORE_JWT_JWKS=C:\ProgramData\LoreHub\lore-jwks.json
RUST_LOG=lorehub=info
