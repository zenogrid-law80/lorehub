<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>co.kr.zenogrid.lorehub.runner</string>
  <key>ProgramArguments</key><array><string>@RUNNER_SCRIPT@</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>5</integer>
  <key>StandardOutPath</key><string>@STDOUT_LOG@</string>
  <key>StandardErrorPath</key><string>@STDERR_LOG@</string>
</dict>
</plist>
