DATABASE_URL=postgres://lorehub:change-me@db.example.com:5432/lorehub
LOREHUB_WORK_DIR="/Library/Application Support/LoreHub Runner/work"
LOREHUB_RUNNER_NAME=macos-runner-01
# Optional fixed UUID. Without it, LoreHub persists one in the work directory.
# LOREHUB_RUNNER_ID=00000000-0000-0000-0000-000000000003
LORE_BIN=/usr/local/libexec/lorehub-runner/lore
LOREHUB_PUBLIC_URL=https://lorehub.zenogrid.co.kr
LOREHUB_AUTO_UPDATE=true
LOREHUB_UPDATE_INTERVAL_SECONDS=300
LORE_JWT_PRIVATE_KEY="/Library/Application Support/LoreHub Runner/lore-jwt-private.pem"
LORE_JWT_JWKS="/Library/Application Support/LoreHub Runner/lore-jwks.json"
RUST_LOG=lorehub=info
